# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
APP_URL=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/marzx_site
POSTGRES_PASSWORD=your-postgres-password

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret
JWT_REFRESH_SECRET=change-this-to-another-long-random-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ── Resend (email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM=noreply@yourdomain.com

# ── Platega ───────────────────────────────────────────────────────────────────
PLATEGA_MERCHANT_ID=your-merchant-uuid
PLATEGA_SECRET=your-platega-secret-key

# ── Marzban Panel ─────────────────────────────────────────────────────────────
MARZBAN_API_URL=https://panel.yourdomain.com
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=your-marzban-admin-password
