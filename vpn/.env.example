# ── Domain & TLS ──────────────────────────────────────────────────────────────
# Domain pointed to this server (required for Let's Encrypt)
VPN_DOMAIN=vpn.example.com

# Email for Let's Encrypt expiry notifications
ADMIN_EMAIL=admin@example.com

# ── Panel Connection ───────────────────────────────────────────────────────────
# URL of the Marzban panel that manages this node
PANEL_API_URL=https://panel.example.com

# ── Node Service Ports ─────────────────────────────────────────────────────────
# Port the Marzban panel uses to control this node (open in firewall)
SERVICE_PORT=62050

# Internal Xray API port (no need to expose externally)
XRAY_API_PORT=62051

# ── Xray ──────────────────────────────────────────────────────────────────────
# Auto-generated by setup.sh — leave empty, the script fills this in
XRAY_UUID=

# Node display name in the Marzban panel
NODE_NAME=node-1

# ── Node security ─────────────────────────────────────────────────────────────
# Path to the client certificate from your Marzban panel.
# In the panel: Settings → Nodes → copy the certificate → save to a file,
# then set this variable to the file path inside the container, e.g.:
#   SSL_CLIENT_CERT_FILE=/var/lib/marzban-node/client_cert.pem
# Leave empty to allow any panel to connect (NOT recommended for production).
SSL_CLIENT_CERT_FILE=
